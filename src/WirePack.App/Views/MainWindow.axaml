<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WirePack.App.ViewModels"
        xmlns:views="using:WirePack.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="WirePack.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WirePack — Расчёт диаметра защитной трубки"
        MinWidth="900" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Margin="0,0,0,6">
            <MenuItem Header="Проект">
                <MenuItem Header="Открыть..."
                          Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="Сохранить"
                          Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="Сохранить как..."
                          Command="{Binding SaveProjectAsCommand}" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе..."
                          Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <Grid ColumnDefinitions="380, Auto, *"
              RowDefinitions="*, Auto"
              Margin="10">

        <!-- ===== Левая панель: ввод данных ===== -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemAccentColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,5,0">
            <Grid RowDefinitions="Auto, *, Auto, Auto">
                <TextBlock Grid.Row="0"
                           Text="Исходные данные"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <!-- Список групп (изменяемый по вертикали) -->
                <ScrollViewer Grid.Row="1"
                              MinHeight="80">
                    <ItemsControl ItemsSource="{Binding WireGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray"
                                        BorderThickness="0,0,0,1"
                                        Background="{Binding GroupBackgroundBrush}"
                                        Padding="0,4">
                                    <Grid ColumnDefinitions="*, 80, Auto"
                                          ColumnSpacing="4">
                                        <StackPanel Grid.Column="0"
                                                    Orientation="Vertical">
                                            <TextBlock Text="Диаметр, мм"
                                                       FontSize="11" />
                                            <TextBox Text="{Binding Diameter}"
                                                     Width="80"
                                                     FontSize="13" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Vertical">
                                            <TextBlock Text="Кол-во"
                                                       FontSize="11" />
                                            <TextBox Text="{Binding Count}"
                                                     Width="60"
                                                     FontSize="13" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Width="28" Height="28"
                                                Margin="0,14,0,0"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveGroupCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Сплиттер для изменения размера списка проводов по вертикали -->
                <GridSplitter Grid.Row="2"
                              Height="4"
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />

                <!-- Блок снизу списка (минимизирован по высоте изначально) -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <!-- Кнопка Add -->
                        <Button Content="+ Добавить группу"
                                Command="{Binding AddGroupCommand}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" />

                        <!-- Разделитель -->
                        <Rectangle Height="1"
                                   Fill="LightGray"
                                   Margin="0,12,0,8" />

                        <!-- Кнопки Start / Stop -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,0,0,8">
                            <Button Content="Рассчитать"
                                    Command="{Binding StartCalculationCommand}"
                                    IsEnabled="{Binding IsNotRunning}"
                                    FontWeight="Bold"
                                    Width="140" Height="36"
                                    Background="{DynamicResource SystemAccentColor}"
                                    Foreground="White" />
                            <Button Content="Остановить"
                                    Command="{Binding StopCalculationCommand}"
                                    IsEnabled="{Binding IsRunning}"
                                    Width="120" Height="36" />
                        </StackPanel>

                        <!-- Статус -->
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding ElapsedText, StringFormat='Время: {0}'}"
                                   FontSize="12"
                                   Foreground="Gray" />

                        <!-- Прогресс итераций -->
                        <TextBlock Text="{Binding CurrentIteration, StringFormat='Итерация: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding CurrentRestartCount, StringFormat='Перезапуски: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding CurrentBestDiameter, StringFormat='Лучший диаметр: {0:F2} мм'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,8" />

                        <!-- Чек-бокс визуализации -->
                        <CheckBox Content="Визуализировать расчёт"
                                  IsChecked="{Binding IsVisualizationEnabled}"
                                  Margin="0,0,0,8" />

                        <!-- Чек-бокс тестовых данных -->
                        <CheckBox Content="Заполнить тестовыми данными"
                                  IsChecked="{Binding IsTestDataSet}"
                                  Margin="0,0,0,8" />

                        <!-- Ошибки -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="12"
                                   Foreground="Red"
                                   TextWrapping="Wrap"
                                   MaxHeight="60" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Разделитель -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      Background="Transparent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />

        <!-- ===== Правая панель: визуализация и варианты ===== -->
        <Grid Grid.Column="2"
              RowDefinitions="*, Auto"
              Margin="5,0,0,0">

            <!-- LayoutCanvas -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,8">
                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="8">
                    <!-- Background убрали, так как LayoutCanvas не регистрирует его как обычного CLR-свойства -->
                    <views:LayoutCanvas Variant="{Binding SelectedVariant}"
                                        IsRunning="{Binding IsRunning}" />
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Padding="8,4"
                        CornerRadius="4"
                        Background="#80000000"
                        IsVisible="{Binding IsRunning}">
                    <TextBlock Text="{Binding CurrentPhaseText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
            </Grid>

            <!-- Список вариантов -->
            <Border Grid.Row="1"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    MaxHeight="180"
                    IsVisible="{Binding HasVariants}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Варианты компоновки"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding SelectedVariant.FillFactorPercent, StringFormat='Заполнение выбранного варианта: {0:F1}%'}"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding Variants}"
                             SelectedItem="{Binding SelectedVariant}"
                             MaxHeight="130">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>